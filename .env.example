# Configuração da API OpenAI
OPENAI_API_KEY=sua_chave_openai_aqui

# Configuração opcional do modelo de imagem
# Opções: gpt-image-1, dall-e-3
IMAGE_MODEL=gpt-image-1

# Desabilitar fallback para DALL·E-3 (true/false)
# true = usa apenas gpt-image-1; se falhar, retorna erro (recomendado)
DISABLE_IMAGE_FALLBACK=true

# Configuração opcional do tamanho da imagem
# Para gpt-image-1: 1024x1024, 1024x1536, 1536x1024, auto
# Para dall-e-3: 1024x1024, 1024x1792, 1792x1024
IMAGE_SIZE=1536x1024

# Pexels (opcional, para buscar imagens do banco)
# Obtenha em: https://www.pexels.com/api/
PEXELS_API_KEY=sua_chave_pexels_aqui

# Configuração do servidor (Railway define automaticamente)
PORT=8000
